{
  "rules": {
    "online": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isNumber()"
      }
    },
    "roomOnline": {
      "$room": {
        ".read": "auth != null",
        ".validate": "$room.matches(/^[a-z0-9-]{1,40}$/)",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber()"
        }
      }
    }
  }
}
