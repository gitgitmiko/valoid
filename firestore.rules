rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /users/{uid}/favorites/{skinId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    function validHistory(uid, date) {
      return signedIn() && request.auth.uid == uid
        && request.resource.data.date == date
        && request.resource.data.offers is list
        && request.resource.data.offers.size() <= 8;
    }

    // Info dari developer; ditulis admin lewat tools/post_announcement.py.
    match /announcements/{id} {
      allow read: if true;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Profil publik di chat. lastMessageAt hanya boleh diisi waktu server (ditulis bersama pesan).
    function validChatUser() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'tag', 'tier', 'tierName', 'rankIcon', 'cardArt', 'region', 'lastMessageAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 32
        && d.tag is string && d.tag.size() <= 8
        && d.tier is int && d.tier >= 0 && d.tier <= 27
        && d.region in ['ap', 'eu', 'na', 'kr']
        && (!('lastMessageAt' in d) || d.lastMessageAt == request.time
            || (resource != null && 'lastMessageAt' in resource.data && d.lastMessageAt == resource.data.lastMessageAt));
    }

    match /chatUsers/{uid} {
      allow read: if signedIn();
      allow create, update: if owner(uid) && validChatUser();
    }

    function chatUser() {
      return /databases/$(database)/documents/chatUsers/$(request.auth.uid);
    }

    // Admin ditetapkan lewat konsol (admins/{uid}); tidak bisa ditulis dari aplikasi.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if owner(uid);
    }

    // Ban dari chat; pengguna bisa membaca status ban-nya sendiri.
    match /bans/{uid} {
      allow read: if owner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Laporan pesan: dibuat pelapor, hanya admin yang bisa membaca dan menghapus.
    match /reports/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reporterUid', 'room', 'messageId', 'targetUid', 'targetName', 'text', 'reason', 'detail', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reason in ['spam', 'harassment', 'sexual', 'scam', 'cheat', 'other']
        && request.resource.data.text is string && request.resource.data.text.size() <= 500
        && request.resource.data.detail is string && request.resource.data.detail.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
    }

    // Pengguna yang diblokir pemilik; hanya memengaruhi tampilan pemilik.
    match /users/{uid}/blocked/{target} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['name', 'tag', 'createdAt']);
    }

    // Kelompok rank; harus sama dengan RankRooms di aplikasi.
    function rankGroup(t) {
      return t < 3 ? 'unranked'
        : t <= 8 ? 'iron-bronze'
        : t <= 14 ? 'silver-gold'
        : t <= 20 ? 'plat-diamond'
        : 'ascendant-plus';
    }

    function validParty(p) {
      return p is map && p.keys().hasOnly(['size', 'mode', 'need', 'note'])
        && p.size in [2, 3, 5]
        && p.mode in ['competitive', 'unrated', 'swiftplay', 'premier', 'custom']
        && p.need is int && p.need >= 1 && p.need < p.size
        && p.note is string && p.note.size() <= 120;
    }

    // Pesan room: hanya dibuat oleh pengirimnya, dengan identitas sama seperti chatUsers,
    // paling cepat satu pesan per 3 detik. Room rank hanya untuk wilayah dan kelompok rank pengirim.
    // Tidak bisa diubah atau dihapus pengguna.
    match /rooms/{room}/messages/{id} {
      allow read: if signedIn();
      allow delete: if isAdmin();
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/bans/$(request.auth.uid))
        && room.matches('^[a-z0-9-]{1,40}$')
        && request.resource.data.keys().hasOnly(['uid', 'name', 'tag', 'tierName', 'rankIcon', 'cardArt', 'region', 'text', 'createdAt', 'party'])
        && (!('party' in request.resource.data) || validParty(request.resource.data.party))
        && (room == 'global'
            || room == getAfter(chatUser()).data.region + '-' + rankGroup(getAfter(chatUser()).data.tier))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time
        && getAfter(chatUser()).data.lastMessageAt == request.time
        && request.resource.data.name == getAfter(chatUser()).data.name
        && request.resource.data.tag == getAfter(chatUser()).data.tag
        && (!exists(chatUser()) || !('lastMessageAt' in get(chatUser()).data)
            || get(chatUser()).data.lastMessageAt < request.time - duration.value(3, 's'));
    }

    // Penanda akun Riot agar riwayatnya bisa ditemukan saat akun Valoid dihapus.
    match /users/{uid}/accounts/{puuid} {
      allow read, delete: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['puuid'])
        && request.resource.data.puuid == puuid;
    }

    // Riwayat per akun Riot; dibuat sekali per rotasi dan tidak bisa diubah. Hanya dihapus bersama akun.
    match /users/{uid}/accounts/{puuid}/shopHistory/{date} {
      allow read, delete: if owner(uid);
      allow create: if validHistory(uid, date);
    }

    // Riwayat versi lama (sebelum banyak akun); masih ditulis oleh aplikasi versi lama.
    match /users/{uid}/shopHistory/{date} {
      allow read, delete: if owner(uid);
      allow create: if validHistory(uid, date);
    }
  }
}
