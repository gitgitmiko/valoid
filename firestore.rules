rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /users/{uid}/favorites/{skinId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Riwayat hanya bisa dibuat sekali per rotasi; tidak bisa diubah atau dihapus.
    match /users/{uid}/shopHistory/{date} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.date == date
        && request.resource.data.offers is list
        && request.resource.data.offers.size() <= 8;
    }
  }
}
